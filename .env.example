# Recommended: keep secrets as 1Password references and run through `op run`.
# Plaintext values also work locally, but never commit them.
BUZZSPROUT_PODCAST_ID=1973705
BUZZSPROUT_API_TOKEN=op://Personal/Buzzsprout API/credential

# Directus token needs read/create/update access to podcast_episodes
DIRECTUS_URL=
PODCAST_DIRECTUS_TOKEN=op://Agent Runtime/content-bot/credential
DIRECTUS_EPISODES_COLLECTION=podcast_episodes

PODCAST_NAME=Mike Murphy Unplugged

# Public n8n intake endpoint for /evergreen waitlist signups.
PUBLIC_WAITLIST_ENDPOINT=https://flow.imurph.com/webhook/evergreen-waitlist
