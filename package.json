{
  "name": "extinct-ellipse",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check:content-links": "node scripts/check-content-links.mjs",
    "check:built-links": "node scripts/check-built-links.mjs",
    "check:built-metadata": "node scripts/check-built-metadata.mjs",
    "audit:content": "node scripts/generate-content-audit.mjs",
    "prebuild": "npm run check:content-links",
    "build": "astro build",
    "postbuild": "node scripts/copy-md-twins.mjs && pagefind --site dist && npm run check:built-links && npm run check:built-metadata",
    "import:ai-unplugged": "node scripts/import-ai-unplugged-from-obsidian.mjs",
    "redirects": "node scripts/generate-redirects.mjs",
    "redirects:cloudflare-main": "node scripts/generate-main-site-redirects.mjs",
    "qa:launch": "node scripts/qa-launch.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^7.2.1",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "pagefind": "^1.5.2",
    "playwright": "^1.61.1"
  }
}
