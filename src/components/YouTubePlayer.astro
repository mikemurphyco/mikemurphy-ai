---
import { getYouTubeId, parseVideoChapters, youtubeTimestampUrl } from '../lib/youtube';

interface Props {
  url: string;
  title: string;
  chapters?: string;
}

const { url, title, chapters: chapterSource } = Astro.props;
const videoId = getYouTubeId(url);

if (!videoId) {
  throw new Error(`Invalid YouTube URL for "${title}": ${url}`);
}

const chapters = chapterSource ? parseVideoChapters(chapterSource) : [];
---

<section class="youtube-player" data-youtube-component>
  <div class="mm-card aspect-video overflow-hidden">
    <iframe
      src={`https://www.youtube-nocookie.com/embed/${videoId}?enablejsapi=1&playsinline=1`}
      title={title}
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
      class="h-full w-full"
      data-youtube-player
    ></iframe>
  </div>

  {chapters.length > 0 && (
    <div class="chapter-panel mm-card mt-4 overflow-hidden" data-youtube-chapters>
      <div class="chapter-header">
        <div class="chapter-title">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="m9 7 8 5-8 5V7Z" fill="currentColor"></path>
          </svg>
          <h2>Jump to a chapter</h2>
        </div>
        <p>{chapters.length} sections</p>
      </div>
      <ol class="chapter-list" aria-label={`Chapters for ${title}`}>
        {chapters.map((chapter, index) => (
          <li data-chapter-extra={index >= 5 ? '' : undefined}>
            <a
              class="chapter-link"
              href={youtubeTimestampUrl(videoId, chapter.seconds)}
              data-chapter-seconds={chapter.seconds}
            >
              <time datetime={`PT${chapter.seconds}S`}>{chapter.timestamp}</time>
              <span>{chapter.label}</span>
            </a>
          </li>
        ))}
      </ol>
      {chapters.length > 5 && (
        <button class="chapter-toggle" type="button" aria-expanded="false" data-chapter-toggle hidden>
          <span data-chapter-toggle-label>Show all {chapters.length} chapters</span>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="m7 10 5 5 5-5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
          </svg>
        </button>
      )}
    </div>
  )}
</section>

<style>
  .chapter-panel {
    border-top: 3px solid var(--mm-orange);
  }

  .chapter-header {
    align-items: center;
    display: flex;
    gap: var(--space-4);
    justify-content: space-between;
    padding: 0.9rem var(--space-5) 0.65rem;
  }

  .chapter-header > p {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: var(--ls-label);
    margin: 0;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .chapter-title {
    align-items: center;
    display: flex;
    gap: 0.55rem;
  }

  .chapter-title svg {
    color: var(--mm-orange-deep);
    height: 1.25rem;
    width: 1.25rem;
  }

  .chapter-title h2 {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    margin: 0;
    text-transform: uppercase;
  }

  .chapter-list {
    display: grid;
    gap: 0.2rem;
    list-style: none;
    margin: 0;
    padding: 0.35rem 0.65rem 0.65rem;
  }

  [data-youtube-chapters][data-collapsed='true'] [data-chapter-extra] {
    display: none;
  }

  .chapter-link {
    align-items: center;
    border-left: 3px solid transparent;
    border-radius: var(--radius-sm);
    color: var(--color-text-primary);
    display: grid;
    gap: 0.8rem;
    grid-template-columns: 4rem minmax(0, 1fr);
    padding: 0.55rem 0.65rem;
    text-decoration: none;
    transition: background-color 150ms ease, border-color 150ms ease;
  }

  .chapter-link:hover,
  .chapter-link:focus-visible {
    background: color-mix(in srgb, var(--mm-orange) 9%, transparent);
  }

  .chapter-link:focus-visible {
    outline: 2px solid var(--mm-orange-deep);
    outline-offset: -2px;
  }

  .chapter-link[aria-current='true'] {
    background: color-mix(in srgb, var(--mm-orange) 14%, transparent);
    border-left-color: var(--mm-orange-deep);
  }

  .chapter-link[aria-current='true'] span {
    font-weight: 700;
  }

  .chapter-link time {
    background: color-mix(in srgb, var(--mm-navy) 7%, transparent);
    border: 1px solid color-mix(in srgb, var(--mm-navy) 16%, transparent);
    border-radius: 999px;
    color: var(--color-text-primary);
    display: inline-flex;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    justify-content: center;
    letter-spacing: 0.02em;
    padding: 0.18rem 0.42rem;
  }

  html[data-theme='dark'] .chapter-link time {
    background: color-mix(in srgb, var(--mm-chalk) 8%, transparent);
    border-color: color-mix(in srgb, var(--mm-chalk) 18%, transparent);
  }

  .chapter-toggle {
    align-items: center;
    background: color-mix(in srgb, var(--color-bg-surface) 92%, var(--mm-orange));
    border: 0;
    border-top: 1px solid var(--color-border-default);
    color: var(--mm-orange-deep);
    cursor: pointer;
    display: flex;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    gap: 0.4rem;
    justify-content: center;
    letter-spacing: 0.04em;
    padding: 0.75rem var(--space-4);
    text-transform: uppercase;
    transition: background-color 150ms ease;
    width: 100%;
  }

  .chapter-toggle[hidden] {
    display: none;
  }

  .chapter-toggle:hover,
  .chapter-toggle:focus-visible {
    background: color-mix(in srgb, var(--mm-orange) 15%, var(--color-bg-surface));
  }

  .chapter-toggle:focus-visible {
    outline: 2px solid var(--mm-orange-deep);
    outline-offset: -2px;
  }

  .chapter-toggle svg {
    height: 1rem;
    transition: transform 150ms ease;
    width: 1rem;
  }

  .chapter-toggle[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  @media (max-width: 30rem) {
    .chapter-header {
      align-items: flex-start;
      padding-inline: var(--space-4);
    }

    .chapter-link {
      gap: var(--space-2);
      grid-template-columns: 3.6rem minmax(0, 1fr);
      padding-inline: 0.45rem;
    }
  }
</style>

<script>
  type YouTubePlayerInstance = {
    getCurrentTime: () => number;
    playVideo: () => void;
    seekTo: (seconds: number, allowSeekAhead: boolean) => void;
  };

  type YouTubeApi = {
    Player: new (
      element: HTMLIFrameElement,
      options: { events: { onReady: () => void; onStateChange: (event: { data: number }) => void } },
    ) => YouTubePlayerInstance;
  };

  type YouTubeWindow = Window &
    typeof globalThis & {
      YT?: YouTubeApi;
      __youtubeIframeApi?: Promise<YouTubeApi>;
      onYouTubeIframeAPIReady?: () => void;
    };

  function loadYouTubeApi() {
    const youtubeWindow = window as YouTubeWindow;

    if (youtubeWindow.YT?.Player) return Promise.resolve(youtubeWindow.YT);
    if (youtubeWindow.__youtubeIframeApi) return youtubeWindow.__youtubeIframeApi;

    youtubeWindow.__youtubeIframeApi = new Promise<YouTubeApi>((resolve) => {
      const previousReady = youtubeWindow.onYouTubeIframeAPIReady;

      youtubeWindow.onYouTubeIframeAPIReady = () => {
        previousReady?.();
        if (youtubeWindow.YT) resolve(youtubeWindow.YT);
      };

      if (!document.querySelector('script[src="https://www.youtube.com/iframe_api"]')) {
        const script = document.createElement('script');
        script.src = 'https://www.youtube.com/iframe_api';
        script.async = true;
        document.head.append(script);
      }
    });

    return youtubeWindow.__youtubeIframeApi;
  }

  document.querySelectorAll<HTMLElement>('[data-youtube-component]').forEach((component) => {
    if (component.dataset.youtubeReady === 'true') return;
    component.dataset.youtubeReady = 'true';

    const iframe = component.querySelector<HTMLIFrameElement>('[data-youtube-player]');
    const links = Array.from(
      component.querySelectorAll<HTMLAnchorElement>('[data-chapter-seconds]'),
    );
    const chaptersPanel = component.querySelector<HTMLElement>('[data-youtube-chapters]');
    const chapterToggle = component.querySelector<HTMLButtonElement>('[data-chapter-toggle]');
    const chapterToggleLabel = component.querySelector<HTMLElement>('[data-chapter-toggle-label]');

    if (!iframe || links.length === 0) return;

    if (chaptersPanel && chapterToggle && chapterToggleLabel) {
      chaptersPanel.dataset.collapsed = 'true';
      chapterToggle.hidden = false;

      chapterToggle.addEventListener('click', () => {
        const expanded = chapterToggle.getAttribute('aria-expanded') === 'true';
        chapterToggle.setAttribute('aria-expanded', String(!expanded));
        chaptersPanel.dataset.collapsed = String(expanded);
        chapterToggleLabel.textContent = expanded
          ? `Show all ${links.length} chapters`
          : 'Show fewer chapters';
      });
    }

    let player: YouTubePlayerInstance | undefined;
    let updateTimer: number | undefined;

    const setActiveChapter = (currentTime: number) => {
      let activeLink = links[0];

      for (const link of links) {
        if (Number(link.dataset.chapterSeconds) <= currentTime) activeLink = link;
        else break;
      }

      for (const link of links) {
        if (link === activeLink) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      }
    };

    const playerReady = loadYouTubeApi().then(
      (YT) =>
        new Promise<YouTubePlayerInstance>((resolve) => {
          player = new YT.Player(iframe, {
            events: {
              onReady: () => {
                if (player) resolve(player);
              },
              onStateChange: ({ data }) => {
                if (updateTimer) window.clearInterval(updateTimer);
                updateTimer = undefined;

                if (player) setActiveChapter(player.getCurrentTime());
                if (data === 1) {
                  updateTimer = window.setInterval(() => {
                    if (player) setActiveChapter(player.getCurrentTime());
                  }, 500);
                }
              },
            },
          });
        }),
    );

    for (const link of links) {
      link.addEventListener('click', async (event) => {
        event.preventDefault();
        const seconds = Number(link.dataset.chapterSeconds);
        setActiveChapter(seconds);

        try {
          const readyPlayer = await playerReady;
          readyPlayer.seekTo(seconds, true);
          readyPlayer.playVideo();
        } catch {
          window.location.href = link.href;
        }
      });
    }
  });
</script>
