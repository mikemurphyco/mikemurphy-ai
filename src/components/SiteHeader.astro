---
import ThemeToggle from './ThemeToggle.astro';

const contentItems = [
  { href: '/tutorials/', label: 'Tutorials', desc: 'Step-by-step, clearly explained' },
  { href: '/articles/', label: 'Articles', desc: 'Longer reads and how-tos' },
  { href: '/field-notes/', label: 'Field Notes', desc: 'Quick tips, snippets, and shortcuts' },
  { href: '/podcast/', label: 'Podcast', desc: 'Mike Murphy Unplugged' },
];

const moreItems = [
  { href: '/ai-unplugged/', label: 'AI Unplugged' },
  { href: '/resources/', label: 'Resources' },
  { href: '/about/', label: 'About' },
];

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  return href === '/' ? currentPath === '/' : currentPath.startsWith(href);
}

const contentActive = contentItems.some((item) => isActive(item.href));
---

<header class="mm-header">
  <div class="mm-header__inner">
    <a href="/" class="mm-lockup" aria-label="Mike Murphy home">
      <img src="/assets/brand/loop-orange-128.svg" alt="" class="mm-lockup__mark" width="42" height="42" />
      <span class="mm-lockup__words">
        <span class="mm-lockup__name">Mike Murphy</span>
        <span class="mm-lockup__eyebrow">AI Handyman</span>
      </span>
    </a>

    <nav class="mm-nav" aria-label="Main">
      <div class="mm-nav__dropdown">
        <button
          type="button"
          id="mm-content-trigger"
          class:list={['mm-nav__link mm-nav__trigger', contentActive && 'is-active']}
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="mm-content-menu"
        >
          Content
          <svg class="mm-nav__chevron" width="9" height="9" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M1.5 3.5 L5 7 L8.5 3.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>

        <div id="mm-content-menu" class="mm-dropdown" hidden>
          {contentItems.map((item) => (
            <a
              href={item.href}
              class="mm-dropdown__item"
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              <span class="mm-dropdown__label">
                {item.label}
                <span class="mm-dropdown__arrow" aria-hidden="true">&rarr;</span>
              </span>
              <span class="mm-dropdown__desc">{item.desc}</span>
            </a>
          ))}
          <div class="mm-dropdown__footer">
            <a href="/topics/" class="mm-dropdown__all">Browse all topics &rarr;</a>
          </div>
        </div>
      </div>

      {moreItems.map((item) => (
        <a
          href={item.href}
          class:list={['mm-nav__link', isActive(item.href) && 'is-active']}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="mm-utility">
      <a href="/search/" class="mm-icon-button" aria-label="Search">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <circle cx="7" cy="7" r="4.5"></circle>
          <path d="M10.5 10.5 L14 14" stroke-linecap="round"></path>
        </svg>
      </a>
      <ThemeToggle />
      <a href="/ai-unplugged/" class="mm-button mm-button-nav mm-utility__cta">Subscribe</a>
      <button
        type="button"
        id="mm-sheet-open"
        class="mm-icon-button mm-icon-button--mobile"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mm-sheet"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M1 4 h14 M1 8 h14 M1 12 h14" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<div id="mm-sheet" class="mm-sheet" hidden>
  <div class="mm-sheet__top">
    <a href="/" class="mm-lockup mm-lockup--sheet" aria-label="Mike Murphy home">
      <img src="/assets/brand/loop-chalk-128.svg" alt="" class="mm-lockup__mark" width="30" height="30" />
      <span class="mm-lockup__words">
        <span class="mm-lockup__name">Mike Murphy</span>
        <span class="mm-lockup__eyebrow">AI Handyman</span>
      </span>
    </a>
    <button type="button" id="mm-sheet-close" class="mm-sheet__close" aria-label="Close menu">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M3 3 L13 13 M13 3 L3 13" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <div class="mm-sheet__body">
    <section class="mm-sheet__section">
      <h2 class="mm-sheet__label">Content</h2>
      {contentItems.map((item) => (
        <a href={item.href} class="mm-sheet__item">
          {item.label}
          <span class="mm-sheet__arrow" aria-hidden="true">&rarr;</span>
        </a>
      ))}
    </section>

    <section class="mm-sheet__section">
      <h2 class="mm-sheet__label">More</h2>
      {moreItems.map((item) => (
        <a href={item.href} class="mm-sheet__item">
          {item.label}
          <span class="mm-sheet__arrow" aria-hidden="true">&rarr;</span>
        </a>
      ))}
    </section>

    <div class="mm-sheet__actions">
      <a href="/ai-unplugged/" class="mm-button mm-sheet__cta">Subscribe</a>
      <button type="button" id="mm-sheet-theme" class="mm-sheet__theme" aria-label="Switch theme">
        <span class="mm-sheet__theme-glyph" aria-hidden="true"></span>
      </button>
    </div>

    <p class="mm-sheet__tagline">
      Learn<span aria-hidden="true"> · </span>Build<span aria-hidden="true"> · </span>Move Forward
    </p>
  </div>
</div>

<style>
  /* ── Header shell ─────────────────────────────────────────────
     The one sanctioned blur surface in the system. No cut-shadow
     on chrome (BRAND-CANON: shadow never lands on nav/footer). */
  .mm-header {
    background: color-mix(in srgb, var(--color-bg-page) 88%, transparent);
    backdrop-filter: saturate(140%) blur(8px);
    border-bottom: 1px solid var(--color-border-default);
    position: sticky;
    top: 0;
    z-index: 30;
  }

  /* Shares .mm-container's measure so the lockup lines up with the page's
     H1 and the CTA lines up with the content's right edge. The canon quotes
     1160px + 32px padding, but the site's container is the real constraint. */
  .mm-header__inner {
    align-items: center;
    display: flex;
    gap: var(--space-12);
    height: 84px;
    margin-inline: auto;
    width: min(100% - 2rem, 72rem);
  }

  /* ── Brand lockup ─────────────────────────────────────────── */
  .mm-lockup {
    align-items: center;
    color: var(--color-text-primary);
    display: flex;
    flex: none;
    gap: var(--space-3);
  }

  .mm-lockup__mark {
    display: block;
    height: 42px;
    width: 42px;
  }

  .mm-lockup__words {
    display: block;
  }

  .mm-lockup__name {
    display: block;
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.15;
    text-transform: uppercase;
  }

  .mm-lockup__eyebrow {
    color: var(--mm-orange);
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  /* ── Desktop nav ──────────────────────────────────────────── */
  .mm-nav {
    align-items: center;
    display: flex;
    gap: 28px;
    margin-left: auto;
  }

  .mm-nav__link {
    background: none;
    border: 0;
    color: var(--color-text-primary);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--fs-mono-label);
    font-weight: 700;
    letter-spacing: 0.15em;
    padding: 0;
    text-transform: uppercase;
    transition: color var(--dur-fast) var(--ease-out);
    white-space: nowrap;
  }

  .mm-nav__link:hover,
  .mm-nav__link.is-active {
    color: var(--mm-orange);
  }

  .mm-nav__link:focus-visible,
  .mm-icon-button:focus-visible,
  .mm-sheet__close:focus-visible,
  .mm-dropdown__item:focus-visible,
  .mm-dropdown__all:focus-visible,
  .mm-sheet__item:focus-visible {
    outline: 2px solid var(--mm-orange);
    outline-offset: 3px;
  }

  .mm-nav__dropdown {
    position: relative;
  }

  .mm-nav__trigger {
    align-items: center;
    display: inline-flex;
    gap: 6px;
  }

  .mm-nav__chevron {
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .mm-nav__trigger[aria-expanded='true'] {
    border-bottom: 2px solid var(--mm-orange);
    color: var(--mm-orange);
    padding-bottom: 2px;
  }

  .mm-nav__trigger[aria-expanded='true'] .mm-nav__chevron {
    transform: rotate(180deg);
  }

  /* ── CONTENT dropdown ─────────────────────────────────────── */
  .mm-dropdown {
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-cut);
    left: -20px;
    padding: var(--space-2);
    position: absolute;
    top: 40px;
    width: 300px;
    z-index: 10;
  }

  html[data-theme='dark'] .mm-dropdown {
    background: var(--color-bg-raised);
  }

  .mm-dropdown__item {
    border-radius: var(--radius-md);
    display: block;
    padding: 11px 14px;
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  /* Neutral wash, not a translucent orange fill — orange over navy
     muddies to brown (settled during design review). */
  .mm-dropdown__item:hover,
  .mm-dropdown__item:focus-visible {
    background: color-mix(in srgb, var(--color-text-primary) 5%, transparent);
  }

  html[data-theme='dark'] .mm-dropdown__item:hover,
  html[data-theme='dark'] .mm-dropdown__item:focus-visible {
    background: color-mix(in srgb, var(--color-text-primary) 7%, transparent);
  }

  .mm-dropdown__label {
    align-items: center;
    color: var(--color-text-primary);
    display: flex;
    font-family: var(--font-mono);
    font-size: var(--fs-mono-label);
    font-weight: 700;
    gap: 6px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .mm-dropdown__arrow {
    color: var(--mm-orange);
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .mm-dropdown__item:hover .mm-dropdown__label,
  .mm-dropdown__item:focus-visible .mm-dropdown__label,
  .mm-dropdown__item[aria-current='page'] .mm-dropdown__label {
    color: var(--mm-orange);
  }

  .mm-dropdown__item:hover .mm-dropdown__arrow,
  .mm-dropdown__item:focus-visible .mm-dropdown__arrow {
    opacity: 1;
  }

  .mm-dropdown__desc {
    color: var(--color-text-muted);
    display: block;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 400;
    line-height: 1.4;
    margin-top: 3px;
  }

  .mm-dropdown__footer {
    border-top: 1px solid var(--color-border-default);
    margin-top: var(--space-2);
    padding: 10px 14px 4px;
  }

  .mm-dropdown__all {
    color: var(--mm-orange);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .mm-dropdown__all:hover {
    color: var(--mm-orange-deep);
  }

  /* ── Utility cluster ──────────────────────────────────────── */
  .mm-utility {
    align-items: center;
    border-left: 1px solid var(--color-border-default);
    display: flex;
    flex: none;
    gap: var(--space-3);
    margin-left: 28px;
    padding-left: 28px;
  }

  .mm-icon-button {
    align-items: center;
    border: 1px solid color-mix(in srgb, var(--color-text-primary) 25%, transparent);
    border-radius: var(--radius-md);
    color: var(--color-text-primary);
    cursor: pointer;
    display: inline-grid;
    height: 38px;
    place-items: center;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
    width: 38px;
  }

  html[data-theme='dark'] .mm-icon-button {
    border-color: color-mix(in srgb, var(--color-text-primary) 30%, transparent);
  }

  .mm-icon-button:hover {
    border-color: var(--color-border-strong);
    color: var(--mm-orange);
  }

  .mm-icon-button--mobile {
    display: none;
  }

  /* ── Mobile sheet ─────────────────────────────────────────── */
  .mm-sheet {
    background: var(--mm-navy);
    color: var(--mm-chalk);
    inset: 0;
    overflow-y: auto;
    position: fixed;
    z-index: 50;
  }

  .mm-sheet[hidden] {
    display: none;
  }

  .mm-sheet__top {
    align-items: center;
    border-bottom: 1px solid color-mix(in srgb, var(--mm-chalk) 10%, transparent);
    display: flex;
    height: 64px;
    justify-content: space-between;
    padding-inline: 20px;
  }

  .mm-lockup--sheet {
    color: var(--mm-chalk);
  }

  .mm-lockup--sheet .mm-lockup__mark {
    height: 30px;
    width: 30px;
  }

  .mm-lockup--sheet .mm-lockup__name {
    font-size: 13px;
  }

  .mm-lockup--sheet .mm-lockup__eyebrow {
    font-size: 9px;
  }

  .mm-sheet__close {
    align-items: center;
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--mm-chalk) 30%, transparent);
    border-radius: var(--radius-md);
    color: var(--mm-chalk);
    cursor: pointer;
    display: grid;
    height: 44px;
    place-items: center;
    width: 44px;
  }

  .mm-sheet__body {
    display: flex;
    flex-direction: column;
    gap: 26px;
    padding: var(--space-6) 20px var(--space-8);
  }

  .mm-sheet__label {
    color: var(--mm-orange);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    margin-bottom: var(--space-1);
    text-transform: uppercase;
  }

  .mm-sheet__item {
    align-items: center;
    border-bottom: 1px solid color-mix(in srgb, var(--mm-chalk) 10%, transparent);
    color: var(--mm-chalk);
    display: flex;
    font-family: var(--font-sans);
    font-size: 17px;
    font-weight: 600;
    justify-content: space-between;
    padding-block: 14px;
  }

  .mm-sheet__arrow {
    color: color-mix(in srgb, var(--mm-chalk) 40%, transparent);
    font-family: var(--font-mono);
    font-size: 14px;
  }

  .mm-sheet__actions {
    align-items: center;
    display: flex;
    gap: var(--space-3);
  }

  .mm-sheet__cta {
    border-color: var(--mm-chalk);
    box-shadow: 4px 4px 0 color-mix(in srgb, var(--mm-chalk) 90%, transparent);
    flex: 1;
    padding: 14px 18px;
  }

  /* Sheet-local theme toggle — the header's ThemeToggle sits behind the
     overlay, so the sheet carries its own control and delegates to it. */
  .mm-sheet__theme {
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--mm-chalk) 30%, transparent);
    border-radius: var(--radius-md);
    color: var(--mm-chalk);
    cursor: pointer;
    display: grid;
    flex: none;
    font-family: var(--font-mono);
    font-size: 15px;
    height: 46px;
    place-items: center;
    width: 46px;
  }

  .mm-sheet__theme:focus-visible {
    outline: 2px solid var(--mm-orange);
    outline-offset: 3px;
  }

  .mm-sheet__theme-glyph::before {
    content: '☾';
  }

  html[data-theme='dark'] .mm-sheet__theme-glyph::before {
    content: '☀';
  }

  .mm-sheet__tagline {
    color: color-mix(in srgb, var(--mm-chalk) 50%, transparent);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .mm-sheet__tagline span {
    color: var(--mm-orange);
  }

  /* ── Breakpoint ───────────────────────────────────────────── */
  /* Hands over to the sheet at 1023px, not the 819px the handoff specified:
     lockup + nav + utility need ~881px, so a lower breakpoint left the
     desktop header overflowing and scrolling the page horizontally. */
  @media (max-width: 1023px) {
    .mm-header__inner {
      gap: var(--space-4);
      height: 64px;
    }

    .mm-lockup__mark {
      height: 30px;
      width: 30px;
    }

    .mm-lockup__name {
      font-size: 13px;
    }

    .mm-lockup__eyebrow {
      font-size: 9px;
    }

    .mm-nav {
      display: none;
    }

    .mm-utility {
      border-left: 0;
      gap: var(--space-2);
      margin-left: auto;
      padding-left: 0;
    }

    .mm-utility .mm-icon-button {
      height: 44px;
      width: 44px;
    }

    .mm-utility__cta {
      display: none;
    }

    .mm-icon-button--mobile {
      display: inline-grid;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mm-nav__chevron,
    .mm-dropdown__item,
    .mm-dropdown__arrow {
      transition: none;
    }
  }
</style>

<script>
  const trigger = document.getElementById('mm-content-trigger');
  const menu = document.getElementById('mm-content-menu') as HTMLElement | null;
  const sheet = document.getElementById('mm-sheet') as HTMLElement | null;
  const sheetOpen = document.getElementById('mm-sheet-open');
  const sheetClose = document.getElementById('mm-sheet-close');

  // ── CONTENT dropdown ──────────────────────────────────────
  function setMenuOpen(open: boolean) {
    if (!trigger || !menu) return;
    menu.hidden = !open;
    trigger.setAttribute('aria-expanded', String(open));
  }

  trigger?.addEventListener('click', (event) => {
    event.stopPropagation();
    setMenuOpen(menu ? menu.hidden === true : false);
  });

  // Click anywhere outside closes.
  document.addEventListener('click', (event) => {
    if (!menu || menu.hidden) return;
    if (event.target instanceof Node && menu.contains(event.target)) return;
    setMenuOpen(false);
  });

  // Arrow keys walk the menu items; Escape closes and returns focus.
  trigger?.addEventListener('keydown', (event) => {
    if (event.key !== 'ArrowDown') return;
    event.preventDefault();
    setMenuOpen(true);
    menu?.querySelector<HTMLAnchorElement>('a')?.focus();
  });

  menu?.addEventListener('keydown', (event) => {
    if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
    const links = Array.from(menu.querySelectorAll<HTMLAnchorElement>('a'));
    const index = links.indexOf(document.activeElement as HTMLAnchorElement);
    if (index === -1) return;
    event.preventDefault();
    const next = event.key === 'ArrowDown' ? index + 1 : index - 1;
    links[(next + links.length) % links.length]?.focus();
  });

  // ── Mobile sheet ──────────────────────────────────────────
  function setSheetOpen(open: boolean) {
    if (!sheet || !sheetOpen) return;
    sheet.hidden = !open;
    sheetOpen.setAttribute('aria-expanded', String(open));
    // Lock the page behind the full-screen overlay.
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) sheetClose?.focus();
    else sheetOpen.focus();
  }

  sheetOpen?.addEventListener('click', () => setSheetOpen(true));
  sheetClose?.addEventListener('click', () => setSheetOpen(false));

  // Delegate to the header toggle so localStorage persistence stays in
  // ThemeToggle.astro rather than being duplicated here.
  document.getElementById('mm-sheet-theme')?.addEventListener('click', () => {
    document.getElementById('mm-theme-toggle')?.click();
  });
  sheet?.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('a')) setSheetOpen(false);
  });

  // Focus trap — the sheet covers everything, so Tab must stay inside it.
  sheet?.addEventListener('keydown', (event) => {
    if (event.key !== 'Tab' || sheet.hidden) return;
    const focusable = Array.from(
      sheet.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'),
    );
    if (focusable.length === 0) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });

  window.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    if (menu && !menu.hidden) {
      setMenuOpen(false);
      trigger?.focus();
    }
    if (sheet && !sheet.hidden) setSheetOpen(false);
  });

  // Leaving mobile width with the sheet open would strand the scroll lock.
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
    if (event.matches && sheet && !sheet.hidden) setSheetOpen(false);
  });
</script>
