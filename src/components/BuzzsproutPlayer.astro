---
interface Props {
  embedUrl: string;
  title: string;
}

const { embedUrl, title } = Astro.props;
---

<div class="mm-card overflow-hidden p-0">
  <iframe
    src={embedUrl}
    width="100%"
    height="200"
    frameborder="0"
    scrolling="no"
    loading="lazy"
    title={`Listen: ${title}`}
  ></iframe>
</div>
