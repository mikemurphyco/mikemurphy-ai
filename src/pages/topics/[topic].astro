---
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/ArticleCard.astro';
import Layout from '../../layouts/Layout.astro';
import { getUnifiedTopicMap, isDiscoverableArticle, isPodcastEpisode, isStandardArticle, isTutorial, sortArticlesByDate } from '../../lib/articles';
import { fieldNoteUrl, isPublishedNote, noteTypeLabel, sortNotesByDate } from '../../lib/field-notes';

export async function getStaticPaths() {
  const articles = sortArticlesByDate(await getCollection('articles', isDiscoverableArticle));
  const notes = sortNotesByDate(await getCollection('fieldNotes', isPublishedNote));
  const topics = getUnifiedTopicMap(articles, notes);

  return topics.map((topic) => ({
    params: { topic: topic.slug },
    props: { topic },
  }));
}

const { topic } = Astro.props;
const itemCount = topic.articles.length + topic.notes.length;
const articles = topic.articles.filter(isStandardArticle);
const podcastEpisodes = topic.articles.filter(isPodcastEpisode);
const tutorials = topic.articles.filter(
  (article) => !isPodcastEpisode(article) && isTutorial(article),
);
const countParts = [
  articles.length > 0 ? `${articles.length} ${articles.length === 1 ? 'article' : 'articles'}` : null,
  tutorials.length > 0 ? `${tutorials.length} ${tutorials.length === 1 ? 'tutorial' : 'tutorials'}` : null,
  podcastEpisodes.length > 0
    ? `${podcastEpisodes.length} podcast ${podcastEpisodes.length === 1 ? 'episode' : 'episodes'}`
    : null,
  topic.notes.length > 0
    ? `${topic.notes.length} ${topic.notes.length === 1 ? 'field note' : 'field notes'}`
    : null,
].filter(Boolean);
---

<Layout
  title={topic.name}
  description={`Explore Mike Murphy tutorials, articles, podcast episodes, and Field Notes about ${topic.name}.`}
  canonical={`/topics/${topic.slug}/`}
>
  <main class="mm-container max-w-5xl py-12">
    <header class="border-b border-[var(--mm-border)] pb-8">
      <a href="/topics/" class="font-mono text-xs font-bold uppercase tracking-[0.12em] text-[var(--mm-orange-deep)] hover:underline">All topics</a>
      <h1 class="mm-h1 mt-4">{topic.name}</h1>
      <p class="mm-lede mt-4">
        {countParts.join(' · ')}
      </p>
    </header>

    {articles.length > 0 && (
      <section class="mt-8">
        <h2 class="mm-h2">Articles</h2>
        <div class="mt-4">
          {articles.map((article) => <ArticleCard article={article} />)}
        </div>
      </section>
    )}

    {tutorials.length > 0 && (
      <section class="mt-10">
        <h2 class="mm-h2">Tutorials</h2>
        <div class="mt-4">
          {tutorials.map((tutorial) => <ArticleCard article={tutorial} />)}
        </div>
      </section>
    )}

    {podcastEpisodes.length > 0 && (
      <section class="mt-10">
        <h2 class="mm-h2">Podcast Episodes</h2>
        <div class="mt-4">
          {podcastEpisodes.map((episode) => <ArticleCard article={episode} fallbackImage="/assets/brand/podcast-cover.jpg" aspectClass="aspect-square" />)}
        </div>
      </section>
    )}

    {topic.notes.length > 0 && (
      <section class="mt-10">
        <h2 class="mm-h2">Field Notes</h2>
        <div class="mt-5 grid gap-4 sm:grid-cols-2">
          {topic.notes.map((note) => (
            <article class="mm-card p-5">
              {note.data.noteType && <p class="mm-eyebrow">{noteTypeLabel(note.data.noteType)}</p>}
              <h3 class="mt-2 text-xl font-bold leading-tight">
                <a href={fieldNoteUrl(note)} class="hover:underline">{note.data.title}</a>
              </h3>
              {note.data.excerpt && <p class="mt-3 text-sm leading-6 text-[var(--mm-muted)]">{note.data.excerpt}</p>}
            </article>
          ))}
        </div>
      </section>
    )}
  </main>
</Layout>
