---
import Layout from '../../layouts/Layout.astro';
import { loadBrandKit } from '../../lib/brand-kit';
import { SITE_EMAIL, SITE_SOCIAL, mailtoHref } from '../../lib/site';

const kit = await loadBrandKit();

const colors = [
  { name: 'Cream', hex: '#F1ECE2', role: 'Page', value: 'var(--mm-cream)' },
  { name: 'Chalk', hex: '#FCFAF6', role: 'Surfaces', value: 'var(--mm-chalk)' },
  { name: 'Navy', hex: '#001E3A', role: 'Ink', value: 'var(--mm-navy)' },
  { name: 'Orange', hex: '#FF6434', role: 'Action', value: 'var(--mm-orange)' },
  { name: 'Orange Deep', hex: '#E8501C', role: 'Hover', value: 'var(--mm-orange-deep)' },
  { name: 'Yellow', hex: '#F5C842', role: 'Success', value: 'var(--mm-yellow)' },
  { name: 'Teal', hex: '#1ECEBE', role: 'AI pop', value: 'var(--mm-teal)' },
] as const;

const stats = [
  { value: kit.youtubeSince, label: 'Teaching on YouTube since' },
  { value: kit.tutorialCount, label: 'Tutorials published' },
  { value: kit.subscriberCount, label: 'YouTube subscribers' },
] as const;

const lockups = [
  { label: 'Primary lockup', src: kit.assets.primaryLockup, background: 'paper' },
  { label: 'AI Handyman lockup', src: kit.assets.aiLockup, background: 'navy' },
] as const;

const loops = [
  { label: 'Loop - orange', src: kit.assets.loopOrange, background: 'paper' },
  { label: 'Loop - navy', src: kit.assets.loopNavy, background: 'paper' },
  { label: 'Loop - cream', src: kit.assets.loopCream, background: 'navy' },
] as const;

const marks = [
  { label: 'M-mark - navy', src: kit.assets.mMarkNavy, background: 'paper' },
  { label: 'M-mark - orange on navy', src: kit.assets.mMarkOrangeNavy, background: 'paper' },
  { label: 'M-mark - cream', src: kit.assets.mMarkCream, background: 'navy' },
] as const;

const photos = [
  { label: 'Headshot', src: kit.assets.headshot, background: 'paper' },
  { label: 'Avatar - orange', src: kit.assets.avatarOrange, background: 'orange' },
  { label: 'Avatar - cutout', src: kit.assets.avatarTransparent, background: 'cream' },
] as const;

function fileType(src: string): string {
  const extension = src.split('.').pop()?.split('?')[0];
  return extension?.toUpperCase() ?? 'Download';
}

function socialValue(label: string, href: string): string {
  if (label === 'Podcast') return 'Mike Murphy Unplugged';
  try {
    const url = new URL(href);
    return url.pathname === '/' ? url.hostname : url.pathname.replace(/^\//, '').replace(/\/$/, '');
  } catch {
    return href;
  }
}
---

<Layout
  title="Brand & Media Kit"
  description="Official Mike Murphy AI Handyman bios, logos, colors, headshots, brand guidelines, and press downloads."
  canonical="/media-kit/"
  image={kit.assets.avatarOrange}
>
  <main data-pagefind-body data-pagefind-filter="type:Brand Kit">
    <section class="border-b border-[var(--mm-border)]">
      <div class="mm-container grid gap-10 py-12 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-center lg:py-16">
        <div>
          <p class="mm-eyebrow">Brand & Media Kit</p>
          <h1 class="mm-h1 mt-3">Mike Murphy<br />AI Handyman</h1>
          <p class="mm-lede mt-5 max-w-3xl">{kit.intro}</p>
          <div class="mt-7 flex flex-wrap gap-4" data-pagefind-ignore>
            <a href={kit.assets.allAssetsZip} class="mm-button" download>Download all assets</a>
            <a href={kit.assets.onePagePdf} class="mm-button mm-button-secondary" download>
              One-page PDF ↓
            </a>
          </div>
        </div>
        <aside class="mx-auto w-full max-w-xs lg:justify-self-end" aria-label="Mike Murphy headshot">
          <div class="mm-polaroid rotate-2">
            <div class="mm-polaroid-photo">
              <img src={kit.assets.headshot} alt="Mike Murphy" />
            </div>
            <p>Mike</p>
          </div>
        </aside>
      </div>
    </section>

    <div class="mm-container">
      <section class="kit-section" aria-labelledby="bios-heading">
        <p class="mm-eyebrow">01 - Bios</p>
        <h2 id="bios-heading" class="mm-h2 mt-2">Copy-and-paste bios</h2>
        <div class="mt-7 grid gap-6 lg:grid-cols-2">
          <article class="kit-card">
            <p class="kit-label">Short bio · approximately 50 words</p>
            <p id="short-bio" class="mt-4 leading-7">{kit.shortBio}</p>
            <button class="kit-copy mt-5" type="button" data-copy-target="short-bio" data-copy-label="Short bio">
              Copy
            </button>
          </article>
          <article class="kit-card">
            <p class="kit-label">Long bio · approximately 100 words</p>
            <p id="long-bio" class="mt-4 leading-7">{kit.longBio}</p>
            <button class="kit-copy mt-5" type="button" data-copy-target="long-bio" data-copy-label="Long bio">
              Copy
            </button>
          </article>
        </div>
      </section>

      <section class="kit-section" aria-labelledby="logos-heading">
        <p class="mm-eyebrow">02 - Logos & Marks</p>
        <h2 id="logos-heading" class="mm-h2 mt-2">The loop, lockups & M-mark</h2>
        <p class="mt-4 max-w-3xl leading-7 text-[var(--mm-muted)]">
          Use the primary lockup when space allows. The loop and M-mark are for compact placements, avatars, and supporting graphics.
        </p>

        <div class="mt-7 grid gap-6 md:grid-cols-2">
          {lockups.map((asset) => (
            <article class="asset-card">
              <div class={`asset-preview asset-preview--wide asset-preview--${asset.background}`}>
                <img src={asset.src} alt={asset.label} />
              </div>
              <div class="asset-meta">
                <span>{asset.label}</span>
                <a href={asset.src} download>{fileType(asset.src)} ↓</a>
              </div>
            </article>
          ))}
        </div>

        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {loops.map((asset) => (
            <article class="asset-card">
              <div class={`asset-preview asset-preview--${asset.background}`}>
                <img src={asset.src} alt={asset.label} />
              </div>
              <div class="asset-meta">
                <span>{asset.label}</span>
                <a href={asset.src} download>{fileType(asset.src)} ↓</a>
              </div>
            </article>
          ))}
          {marks.map((asset) => (
            <article class="asset-card">
              <div class={`asset-preview asset-preview--${asset.background}`}>
                <img src={asset.src} alt={asset.label} />
              </div>
              <div class="asset-meta">
                <span>{asset.label}</span>
                <a href={asset.src} download>{fileType(asset.src)} ↓</a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="kit-section" aria-labelledby="colors-heading">
        <p class="mm-eyebrow">03 - Colors</p>
        <h2 id="colors-heading" class="mm-h2 mt-2">Four core colors on warm paper</h2>
        <p class="mt-4 max-w-3xl leading-7 text-[var(--mm-muted)]">
          Click any swatch to copy its hex code. Cream is the page, chalk is raised surfaces, navy is ink, and orange is action. Yellow and teal are rationed accents - use sparingly.
        </p>
        <div class="mt-7 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {colors.map((color) => (
            <button
              class="swatch"
              type="button"
              data-copy-value={color.hex}
              data-copy-label={color.hex}
              aria-label={`Copy ${color.name} color ${color.hex}`}
            >
              <span class="swatch-color" style={`background:${color.value}`}></span>
              <span class="swatch-copy">
                <strong>{color.name}</strong>
                <span>{color.hex} · {color.role}</span>
              </span>
            </button>
          ))}
        </div>
      </section>

      <section class="kit-section" aria-labelledby="type-heading">
        <p class="mm-eyebrow">04 - Typography</p>
        <h2 id="type-heading" class="mm-h2 mt-2">Two families, one job each</h2>
        <div class="mt-7 grid gap-6 md:grid-cols-2">
          <article class="kit-card">
            <p class="kit-label">Display · headings · labels · code</p>
            <p class="mt-4 font-mono text-3xl font-bold uppercase">IBM Plex Mono</p>
            <p class="mt-4 break-words font-mono leading-7">ABCDEFGHIJKLMNOPQRSTUVWXYZ<br />abcdefghijklmnopqrstuvwxyz 0123456789</p>
            <p class="mt-4 text-sm leading-6 text-[var(--mm-muted)]">Weights 400 and 700. Display is uppercase with tight tracking; labels are uppercase with wide tracking.</p>
          </article>
          <article class="kit-card">
            <p class="kit-label">Body · ledes</p>
            <p class="mt-4 text-3xl font-semibold">IBM Plex Sans</p>
            <p class="mt-4 break-words leading-7">ABCDEFGHIJKLMNOPQRSTUVWXYZ<br />abcdefghijklmnopqrstuvwxyz 0123456789</p>
            <p class="mt-4 text-sm leading-6 text-[var(--mm-muted)]">Weights 400 and 600. Always sentence case - the only body face.</p>
          </article>
        </div>
      </section>

      <section class="kit-section" aria-labelledby="photos-heading">
        <p class="mm-eyebrow">05 - Photos</p>
        <h2 id="photos-heading" class="mm-h2 mt-2">Headshot & avatars</h2>
        <div class="mt-7 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {photos.map((asset) => (
            <article class="asset-card">
              <div class={`photo-preview asset-preview--${asset.background}`}>
                <img src={asset.src} alt={`${asset.label} of Mike Murphy`} />
              </div>
              <div class="asset-meta">
                <span>{asset.label}</span>
                <a href={asset.src} download>{fileType(asset.src)} ↓</a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="kit-section" aria-labelledby="words-heading">
        <p class="mm-eyebrow">06 - Tagline & Boilerplate</p>
        <h2 id="words-heading" class="mm-h2 mt-2">The words that travel with the brand</h2>
        <div class="mt-7 grid gap-6 md:grid-cols-2">
          <article class="tagline-card">
            <p id="tagline">Learn <span>·</span> Build <span>·</span> Move Forward</p>
            <button class="kit-copy kit-copy--paper" type="button" data-copy-target="tagline" data-copy-label="Tagline">
              Copy tagline
            </button>
          </article>
          <article class="kit-card">
            <p class="kit-label">One-line boilerplate</p>
            <p id="boilerplate" class="mt-4 leading-7">{kit.boilerplate}</p>
            <button class="kit-copy mt-5" type="button" data-copy-target="boilerplate" data-copy-label="Boilerplate">
              Copy
            </button>
            <p class="mt-5 border-t border-[var(--mm-border)] pt-4 text-sm leading-6 text-[var(--mm-muted)]">
              Name in print: “Mike Murphy” on first mention, “Mike” after. The brand reads “Mike Murphy | AI Handyman.”
            </p>
          </article>
        </div>
      </section>

      <section class="kit-section" aria-labelledby="stats-heading">
        <p class="mm-eyebrow">07 - By the Numbers</p>
        <h2 id="stats-heading" class="mm-h2 mt-2">Audience & track record</h2>
        <div class="mt-7 grid gap-6 md:grid-cols-3">
          {stats.map((stat) => (
            <article class="kit-card">
              <p class="font-mono text-4xl font-bold">{stat.value}</p>
              <p class="kit-label mt-2">{stat.label}</p>
            </article>
          ))}
        </div>
        <p class="mt-5 text-sm text-[var(--mm-muted)]">Plus a weekly newsletter and the Mike Murphy Unplugged podcast.</p>
      </section>

      <section class="kit-section" aria-labelledby="contact-heading">
        <p class="mm-eyebrow">08 - Contact & Links</p>
        <h2 id="contact-heading" class="mm-h2 mt-2">Get in touch</h2>
        <div class="mt-7 grid gap-6 md:grid-cols-2">
          <article class="kit-card flex flex-col items-start">
            <p class="leading-7">{kit.contactIntro}</p>
            <a href={mailtoHref('Press, podcast, or collaboration')} class="mm-button mt-6">{SITE_EMAIL}</a>
          </article>
          <article class="kit-card py-3">
            <div class="contact-row">
              <span>Website</span>
              <a href="https://mikemurphy.ai">mikemurphy.ai</a>
            </div>
            {SITE_SOCIAL.map((social) => (
              <div class="contact-row">
                <span>{social.label}</span>
                <a href={social.href}>{socialValue(social.label, social.href)}</a>
              </div>
            ))}
          </article>
        </div>
      </section>
    </div>
  </main>

  <div class="copy-toast" role="status" aria-live="polite" hidden></div>

  <script>
    const toast = document.querySelector<HTMLElement>('.copy-toast');
    let toastTimer: number | undefined;

    async function copyText(text: string, label: string) {
      try {
        await navigator.clipboard.writeText(text.trim());
        if (!toast) return;
        toast.textContent = `✓ ${label} copied`;
        toast.hidden = false;
        window.clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => {
          toast.hidden = true;
        }, 1800);
      } catch {
        if (!toast) return;
        toast.textContent = 'Copy failed - select the text and copy it manually.';
        toast.hidden = false;
      }
    }

    document.querySelectorAll<HTMLElement>('[data-copy-target]').forEach((button) => {
      button.addEventListener('click', () => {
        const targetId = button.dataset.copyTarget;
        const target = targetId ? document.getElementById(targetId) : null;
        if (target) void copyText(target.innerText, button.dataset.copyLabel ?? 'Text');
      });
    });

    document.querySelectorAll<HTMLElement>('[data-copy-value]').forEach((button) => {
      button.addEventListener('click', () => {
        const value = button.dataset.copyValue;
        if (value) void copyText(value, button.dataset.copyLabel ?? value);
      });
    });
  </script>
</Layout>

<style>
  .kit-section {
    border-top: 1px solid var(--color-border-default);
    padding-block: clamp(2.75rem, 7vw, 4.5rem);
  }

  .kit-section:first-child {
    border-top: 0;
  }

  .kit-card,
  .asset-card {
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-cut);
  }

  .kit-card {
    padding: clamp(1.25rem, 4vw, 1.75rem);
  }

  .kit-label,
  .asset-meta,
  .contact-row span {
    font-family: var(--font-mono);
    font-size: var(--fs-mono-label);
    font-weight: 700;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
  }

  .kit-copy {
    background: var(--color-bg-page);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-cut);
    color: var(--color-text-primary);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--fs-mono-label);
    font-weight: 700;
    letter-spacing: var(--ls-label);
    padding: 0.55rem 0.9rem;
    text-transform: uppercase;
    transition: transform var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
  }

  .kit-copy:hover,
  .swatch:hover {
    transform: translate(-1px, -1px);
  }

  .kit-copy:active,
  .swatch:active {
    box-shadow: 2px 2px 0 var(--color-shadow-ink);
    transform: translate(2px, 2px);
  }

  .asset-card {
    overflow: hidden;
  }

  .asset-preview,
  .photo-preview {
    align-items: center;
    display: flex;
    justify-content: center;
  }

  .asset-preview {
    min-height: 12rem;
    padding: 2.5rem;
  }

  .asset-preview--wide img {
    max-height: 7rem;
    max-width: min(100%, 32rem);
    width: auto;
  }

  .asset-preview:not(.asset-preview--wide) img {
    height: 5.5rem;
    object-fit: contain;
    width: 5.5rem;
  }

  .asset-preview--paper {
    background: var(--mm-chalk);
  }

  .asset-preview--navy {
    background: var(--mm-navy);
  }

  .asset-preview--orange {
    background: var(--mm-orange);
  }

  .asset-preview--cream {
    background: var(--mm-cream);
  }

  .photo-preview {
    aspect-ratio: 1;
    overflow: hidden;
  }

  .photo-preview img {
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .photo-preview.asset-preview--cream img {
    object-fit: contain;
  }

  .asset-meta {
    align-items: center;
    border-top: 1px solid var(--color-border-default);
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    padding: 0.9rem 1.15rem;
  }

  .asset-meta a {
    color: var(--color-action-primary-hover);
    white-space: nowrap;
  }

  .swatch {
    background: var(--mm-chalk);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-cut);
    color: var(--mm-navy);
    cursor: pointer;
    overflow: hidden;
    padding: 0;
    text-align: left;
    transition: transform var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
  }

  .swatch-color {
    border-bottom: 1px solid rgba(0, 30, 58, 0.18);
    display: block;
    height: 5.5rem;
  }

  .swatch-copy {
    display: flex;
    flex-direction: column;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    gap: 0.2rem;
    padding: 0.8rem 1rem;
  }

  .swatch-copy strong {
    font-size: 0.82rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .swatch-copy span {
    color: rgba(0, 30, 58, 0.65);
  }

  .tagline-card {
    align-items: center;
    background: var(--mm-navy);
    border: 1px solid var(--mm-navy);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-cut);
    color: var(--mm-chalk);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    justify-content: center;
    min-height: 14rem;
    padding: 2rem;
    text-align: center;
  }

  .tagline-card p {
    font-family: var(--font-mono);
    font-size: clamp(1.25rem, 3vw, 1.6rem);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .tagline-card p span {
    color: var(--mm-orange);
  }

  .kit-copy--paper {
    background: var(--mm-chalk);
    border-color: var(--mm-chalk);
    box-shadow: 4px 4px 0 rgba(252, 250, 246, 0.35);
    color: var(--mm-navy);
  }

  .contact-row {
    align-items: flex-start;
    border-bottom: 1px solid var(--color-border-default);
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    padding-block: 0.75rem;
  }

  .contact-row:last-child {
    border-bottom: 0;
  }

  .contact-row a {
    color: var(--color-action-primary-hover);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    overflow-wrap: anywhere;
    text-align: right;
  }

  .copy-toast {
    background: var(--mm-yellow);
    border: 1px solid var(--mm-navy);
    border-radius: var(--radius-md);
    bottom: 1.5rem;
    box-shadow: 4px 4px 0 var(--mm-navy);
    color: var(--mm-navy);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    left: 50%;
    letter-spacing: 0.08em;
    max-width: calc(100% - 2rem);
    padding: 0.7rem 1rem;
    position: fixed;
    text-transform: uppercase;
    transform: translateX(-50%);
    z-index: 50;
  }

  @media (max-width: 560px) {
    .asset-meta,
    .contact-row {
      align-items: flex-start;
      flex-direction: column;
    }

    .contact-row a {
      text-align: left;
    }
  }
</style>
