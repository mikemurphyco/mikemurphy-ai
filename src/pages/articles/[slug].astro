---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { articleMetaDescription, articleUrl, formatDate, getArticleTopicTerms, isDiscoverableArticle, isStandardArticle, slugifyTerm } from '../../lib/articles';
import { articleStructuredData, breadcrumbStructuredData } from '../../lib/structured-data';
import { SITE_AUTHOR } from '../../lib/site';

export async function getStaticPaths() {
  const articles = await getCollection('articles', (article) => isDiscoverableArticle(article) && isStandardArticle(article));
  return articles.map((article) => ({
    params: { slug: article.data.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const terms = getArticleTopicTerms(article);
const metaDescription = articleMetaDescription(article);
const canonicalPath = articleUrl(article);
const structuredData = [
  articleStructuredData({
    url: canonicalPath,
    headline: article.data.title,
    description: metaDescription,
    datePublished: article.data.pubDate,
    dateModified: article.data.updatedDate,
    image: article.data.featuredImage,
    authorName: article.data.author,
  }),
  breadcrumbStructuredData([
    { name: 'Home', url: '/' },
    { name: 'Articles', url: '/articles/' },
    { name: article.data.title, url: canonicalPath },
  ], canonicalPath),
];

const searchable = article.data.search?.include !== false;
const pagefindAttrs = searchable
  ? {
      'data-pagefind-body': true,
      'data-pagefind-filter': 'type[data-type]',
      'data-type': 'Article',
      'data-pagefind-meta': 'date[data-date]',
      'data-pagefind-sort': 'date[data-date]',
      'data-date': new Date(article.data.pubDate).toISOString().slice(0, 10),
    }
  : {};

function getYouTubeId(url: string): string | null {
  const match = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/))([a-zA-Z0-9_-]{11})/);
  return match ? match[1] : null;
}
---

<Layout title={article.data.title} description={metaDescription} canonical={canonicalPath} image={article.data.featuredImage || undefined} imageAlt={article.data.title} author={article.data.author} authorUrl={SITE_AUTHOR.href} ogType="article" structuredData={structuredData}>
  <main>
    <article class="mm-container max-w-3xl py-12" {...pagefindAttrs}>
      <a href="/articles/" class="font-mono text-xs font-bold uppercase tracking-[0.12em] text-[var(--mm-orange-deep)] hover:underline" data-pagefind-ignore>Back to articles</a>
      <h1 class="mm-h1 mt-5">{article.data.title}</h1>
      <p class="mt-4 font-mono text-sm font-bold uppercase tracking-[0.12em] text-[var(--mm-muted)]">
        {formatDate(article.data.pubDate)}
        {article.data.author && <> · <a href={SITE_AUTHOR.href} rel="author" class="hover:underline">{article.data.author}</a></>}
      </p>
      {terms.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-2">
          {terms.slice(0, 8).map((term) => (
            <a href={`/topics/${slugifyTerm(term)}/`} class="mm-pill hover:border-[var(--color-border-strong)]">{term}</a>
          ))}
        </div>
      )}
      {article.data.youtube && article.data.youtube.length > 0 ? (
        <div class="mt-8 space-y-6">
          {article.data.youtube.map((url: string) => {
            const id = getYouTubeId(url);
            return id ? (
              <div class="mm-card aspect-video overflow-hidden">
                <iframe
                  src={`https://www.youtube.com/embed/${id}`}
                  title={article.data.title}
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                  class="h-full w-full"
                />
              </div>
            ) : null;
          })}
        </div>
      ) : article.data.featuredImage && (
        <img src={article.data.featuredImage} alt="" class="mm-card mt-8 w-full object-cover max-h-80" />
      )}
      <div class="mm-prose prose mt-10">
        <Content />
      </div>
    </article>
  </main>
</Layout>
