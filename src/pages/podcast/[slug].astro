---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BuzzsproutPlayer from '../../components/BuzzsproutPlayer.astro';
import { articleMetaDescription, articleRobots, formatDate, getArticleTopicLinks, isDiscoverableArticle, isPodcastEpisode, isRoutableArticle, podcastUrl } from '../../lib/articles';
import { breadcrumbStructuredData, podcastEpisodeStructuredData } from '../../lib/structured-data';
import { SITE_AUTHOR } from '../../lib/site';

export async function getStaticPaths() {
  const episodes = await getCollection('articles', (article) => isRoutableArticle(article) && isPodcastEpisode(article));
  return episodes.map((article) => ({
    params: { slug: article.data.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const topics = isDiscoverableArticle(article) ? getArticleTopicLinks(article) : [];
// Self-hosted show art, reused for any episode without its own custom
// featuredImage — replacing this one file updates every episode at once.
const DEFAULT_PODCAST_IMAGE = '/assets/brand/podcast-cover.jpg';
const displayImage = article.data.featuredImage || DEFAULT_PODCAST_IMAGE;
const metaDescription = articleMetaDescription(article);
const canonicalPath = podcastUrl(article);
const breadcrumbData = breadcrumbStructuredData([
  { name: 'Home', url: '/' },
  { name: 'Podcast', url: '/podcast/' },
  { name: article.data.title, url: canonicalPath },
], canonicalPath);

const searchable = article.data.search?.include !== false;
const pagefindAttrs = searchable
  ? {
      'data-pagefind-body': true,
      'data-pagefind-filter': 'type[data-type]',
      'data-type': 'Podcast',
      'data-pagefind-meta': 'date[data-date]',
      'data-pagefind-sort': 'date[data-date]',
      'data-date': new Date(article.data.pubDate).toISOString().slice(0, 10),
    }
  : {};

const podcastMeta = article.data.podcast;
const structuredData = podcastMeta
  ? [
      breadcrumbData,
      podcastEpisodeStructuredData({
        url: canonicalPath,
        headline: article.data.title,
        description: metaDescription,
        episodeNumber: podcastMeta.episodeNumber,
        datePublished: article.data.pubDate,
        dateModified: article.data.updatedDate,
        image: displayImage,
        durationSeconds: podcastMeta.durationSeconds,
        audioUrl: podcastMeta.audioUrl,
      }),
    ]
  : breadcrumbData;
---

<Layout title={article.data.title} description={metaDescription} canonical={canonicalPath} markdown={isDiscoverableArticle(article) ? `${canonicalPath.replace(/\/$/, '')}.md` : undefined} image={displayImage} imageAlt={article.data.title} author={article.data.author} authorUrl={SITE_AUTHOR.href} robots={articleRobots(article)} structuredData={structuredData}>
  <main>
    <article class:list={["mm-container grid grid-cols-[minmax(0,1fr)] gap-10 py-10", topics.length > 0 && "lg:grid-cols-[minmax(0,1fr)_18rem]"]}>
      <div {...pagefindAttrs}>
        <a href="/podcast/" class="font-mono text-xs font-bold uppercase tracking-[0.12em] text-[var(--mm-orange-deep)] hover:underline" data-pagefind-ignore>Back to podcast</a>
        {podcastMeta && (
          <p class="mm-eyebrow mt-5">Episode {podcastMeta.episodeNumber}</p>
        )}
        <h1 class="mm-h1 mt-3">{article.data.title}</h1>
        <p class="mt-4 font-mono text-sm font-bold uppercase tracking-[0.12em] text-[var(--mm-muted)]">
          {formatDate(article.data.pubDate)} · <a href={SITE_AUTHOR.href} rel="author" class="hover:underline">{article.data.author}</a>
        </p>
        {article.data.description && <p class="mm-lede mt-5">{article.data.description}</p>}
        {podcastMeta?.embedUrl && (
          <div class="mt-6">
            <BuzzsproutPlayer embedUrl={podcastMeta.embedUrl} title={article.data.title} />
          </div>
        )}
        {article.data.featuredImage && (
          <img src={article.data.featuredImage} alt="" class="mm-card mt-8 aspect-video w-full object-cover" />
        )}
        <div class="mm-prose prose mt-10">
          <Content />
        </div>
      </div>
      {topics.length > 0 && (
        <aside class="lg:sticky lg:top-24 lg:h-fit">
          <div class="mm-card p-5">
            <p class="mm-eyebrow">Episode</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {topics.slice(0, 10).map((topic) => (
                <a href={`/topics/${topic.slug}/`} class="mm-pill hover:border-[var(--color-border-strong)]">{topic.name}</a>
              ))}
            </div>
          </div>
        </aside>
      )}
    </article>
  </main>
</Layout>
