---
import { getCollection, render } from 'astro:content';
import SubscribeBand from '../../components/ai-unplugged/SubscribeBand.astro';
import YouTubePlayer from '../../components/YouTubePlayer.astro';
import Layout from '../../layouts/Layout.astro';
import { articleMetaDescription, articleRobots, formatDate, getArticleTopicLinks, isDiscoverableArticle, isRoutableArticle, isTutorial, tutorialUrl } from '../../lib/articles';
import { articleStructuredData, breadcrumbStructuredData } from '../../lib/structured-data';
import { SITE_AUTHOR } from '../../lib/site';
import { getYouTubeId } from '../../lib/youtube';

export async function getStaticPaths() {
  const articles = await getCollection('articles', (article) => isRoutableArticle(article) && isTutorial(article));
  return articles.map((article) => ({
    params: { slug: article.data.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const topics = isDiscoverableArticle(article) ? getArticleTopicLinks(article) : [];
const metaDescription = articleMetaDescription(article);
const canonicalPath = tutorialUrl(article);
const structuredData = [
  articleStructuredData({
    url: canonicalPath,
    headline: article.data.title,
    description: metaDescription,
    datePublished: article.data.pubDate,
    dateModified: article.data.updatedDate,
    image: article.data.featuredImage,
    authorName: article.data.author,
  }),
  breadcrumbStructuredData([
    { name: 'Home', url: '/' },
    { name: 'Tutorials', url: '/tutorials/' },
    { name: article.data.title, url: canonicalPath },
  ], canonicalPath),
];

const searchable = article.data.search?.include !== false;
const pagefindAttrs = searchable
  ? {
      'data-pagefind-body': true,
      'data-pagefind-filter': 'type[data-type]',
      'data-type': 'Tutorial',
      'data-pagefind-meta': 'date[data-date]',
      'data-pagefind-sort': 'date[data-date]',
      'data-date': new Date(article.data.pubDate).toISOString().slice(0, 10),
    }
  : {};
const primaryVideoUrl = article.data.video?.url;
const videoUrls = primaryVideoUrl
  ? [primaryVideoUrl, ...article.data.youtube.filter((url) => url !== primaryVideoUrl)]
  : article.data.youtube;
const embeddableVideoUrls = videoUrls.filter((url) => getYouTubeId(url));
---

<Layout title={article.data.title} description={metaDescription} canonical={canonicalPath} markdown={isDiscoverableArticle(article) ? `${canonicalPath.replace(/\/$/, '')}.md` : undefined} image={article.data.featuredImage || undefined} imageAlt={article.data.title} author={article.data.author} authorUrl={SITE_AUTHOR.href} ogType="article" robots={articleRobots(article)} structuredData={structuredData}>
  <main>
    <article class:list={["mm-container grid grid-cols-[minmax(0,1fr)] gap-10 py-10", topics.length > 0 && "lg:grid-cols-[minmax(0,1fr)_18rem]"]}>
      <div {...pagefindAttrs}>
        <a href="/tutorials/" class="font-mono text-xs font-bold uppercase tracking-[0.12em] text-[var(--mm-orange-deep)] hover:underline" data-pagefind-ignore>Back to tutorials</a>
        <h1 class="mm-h1--article mt-5">{article.data.title}</h1>
        <p class="mt-4 font-mono text-sm font-bold uppercase tracking-[0.12em] text-[var(--mm-muted)]">
          {formatDate(article.data.pubDate)} · <a href={SITE_AUTHOR.href} rel="author" class="hover:underline">{article.data.author}</a>
        </p>
        {article.data.description && <p class="mm-lede mt-5">{article.data.description}</p>}

        {embeddableVideoUrls.length > 0 ? (
          <div class="mt-8 space-y-6">
            {embeddableVideoUrls.map((url: string, index: number) => (
              <YouTubePlayer
                url={url}
                title={article.data.title}
                chapters={index === 0 ? article.data.video?.chapters : undefined}
              />
            ))}
          </div>
        ) : article.data.featuredImage && (
          <img src={article.data.featuredImage} alt="" class="mm-card mt-8 aspect-video w-full object-cover" />
        )}

        <div class="mm-prose prose mt-10">
          <Content />
        </div>
      </div>
      {topics.length > 0 && (
        <aside class="lg:sticky lg:top-24 lg:h-fit">
          <div class="mm-card p-5">
            <p class="mm-eyebrow">Topics</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {topics.slice(0, 10).map((topic) => (
                <a href={`/topics/${topic.slug}/`} class="mm-pill hover:border-[var(--color-border-strong)]">{topic.name}</a>
              ))}
            </div>
          </div>
        </aside>
      )}
    </article>
    <SubscribeBand compact />
  </main>
</Layout>
