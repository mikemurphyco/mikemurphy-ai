---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { SITE_DESCRIPTION, SITE_TITLE, absoluteUrl } from '../lib/articles';
import { SITE_FEEDS, SITE_X_HANDLE } from '../lib/site';
import { serializeJsonLd, type JsonLd } from '../lib/structured-data';

interface Props {
	title?: string;
	description?: string;
	canonical?: string;
	image?: string;
	imageAlt?: string;
	author?: string;
	authorUrl?: string;
	robots?: string;
	noHeader?: boolean;
	ogType?: 'website' | 'article' | 'profile';
	structuredData?: JsonLd | JsonLd[];
}

const {
	title = SITE_TITLE,
	description = SITE_DESCRIPTION,
	canonical = Astro.url.pathname,
	image = '/assets/brand/og-default.png',
	imageAlt = 'Mike Murphy — AI Handyman',
	author,
	authorUrl,
	robots,
	noHeader = false,
	ogType = 'website',
	structuredData = [],
} = Astro.props;

const brandedPageTitle = `${title} | ${SITE_TITLE}`;
const pageTitle =
	title === SITE_TITLE
		? SITE_TITLE
		: brandedPageTitle.length <= 60
			? brandedPageTitle
			: title;
const socialTitle = title;
const canonicalUrl = canonical.startsWith('http') ? canonical : absoluteUrl(canonical);
const imageUrl = image.startsWith('http') ? image : absoluteUrl(image);
const absoluteAuthorUrl = authorUrl
	? authorUrl.startsWith('http') ? authorUrl : absoluteUrl(authorUrl)
	: undefined;
const structuredDataItems = Array.isArray(structuredData) ? structuredData : [structuredData];
const imageExtension = new URL(imageUrl).pathname.split('.').pop()?.toLowerCase();
const imageMimeType = imageExtension === 'png'
	? 'image/png'
	: imageExtension === 'jpg' || imageExtension === 'jpeg'
		? 'image/jpeg'
		: imageExtension === 'webp'
			? 'image/webp'
			: imageExtension === 'gif'
				? 'image/gif'
				: undefined;
---

<!doctype html>
<html lang="en" data-theme="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<script is:inline>
			(function () {
				try {
					var theme = localStorage.getItem('mm-theme');
					document.documentElement.setAttribute(
						'data-theme',
						theme === 'dark' || theme === 'light' ? theme : 'light',
					);
				} catch (e) {
					document.documentElement.setAttribute('data-theme', 'light');
				}
			})();
		</script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#001E3A" />
		<meta name="color-scheme" content="light dark" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		{author && <meta name="author" content={author} />}
		{robots && <meta name="robots" content={robots} />}
		<link rel="canonical" href={canonicalUrl} />
		{SITE_FEEDS.map((feed) => (
			<link
				rel="alternate"
				type="application/rss+xml"
				title={feed.title}
				href={absoluteUrl(feed.href)}
			/>
		))}
		<meta property="og:site_name" content={SITE_TITLE} />
		<meta property="og:title" content={socialTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:type" content={ogType} />
		{ogType === 'article' && absoluteAuthorUrl && (
			<meta property="article:author" content={absoluteAuthorUrl} />
		)}
		<meta property="og:image" content={imageUrl} />
		{imageMimeType && <meta property="og:image:type" content={imageMimeType} />}
		<meta property="og:image:alt" content={imageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content={SITE_X_HANDLE} />
		<meta name="twitter:creator" content={SITE_X_HANDLE} />
		<meta name="twitter:title" content={socialTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		<meta name="twitter:image:alt" content={imageAlt} />
		{structuredDataItems.map((item) => (
			<script type="application/ld+json" set:html={serializeJsonLd(item)} />
		))}
		{import.meta.env.PROD && (
			<>
				<script async is:inline src="https://www.googletagmanager.com/gtag/js?id=G-CGTD41XG4M"></script>
				<script is:inline>
					window.dataLayer = window.dataLayer || [];
					function gtag(){ window.dataLayer.push(arguments); }
					gtag('js', new Date());
					gtag('config', 'G-CGTD41XG4M');
				</script>
			</>
		)}
	</head>
	<body class="antialiased">
		{!noHeader && <SiteHeader />}
		<slot />
		<footer class="border-t border-[var(--mm-navy)] bg-[var(--mm-navy)] text-[var(--mm-cream)]">
			<div class="mm-container grid gap-10 py-12 md:grid-cols-[1.35fr_0.8fr_0.8fr]">
				<div>
					<a href="/" class="flex items-center gap-3" aria-label="Mike Murphy home">
						<img src="/assets/brand/loop-orange-128.svg" alt="" class="size-11" />
						<span>
							<span class="block font-mono text-lg font-bold uppercase">Mike Murphy</span>
							<span class="block font-mono text-xs font-bold uppercase tracking-[0.16em] text-[var(--mm-orange)]">AI Handyman</span>
						</span>
					</a>
					<p class="mt-5 max-w-md text-sm leading-6 text-[color-mix(in_srgb,var(--mm-cream)_72%,transparent)]">
						Practical tutorials, AI workflows, and honest notes from the messy middle of learning in public.
					</p>
					<p class="mt-5 font-mono text-xs font-bold uppercase tracking-[0.14em]">
						Learn <span class="text-[var(--mm-orange)]">·</span> Build <span class="text-[var(--mm-orange)]">·</span> Move Forward
					</p>
					<SocialLinks variant="footer" class="mt-6" />
				</div>
				<nav aria-label="Explore">
					<p class="font-mono text-xs font-bold uppercase tracking-[0.14em] text-[var(--mm-orange)]">Explore</p>
					<div class="mt-4 grid gap-3 text-sm font-semibold">
						<a href="/tutorials/" class="hover:text-[var(--mm-orange)]">Tutorials</a>
						<a href="/articles/" class="hover:text-[var(--mm-orange)]">Articles</a>
						<a href="/field-notes/" class="hover:text-[var(--mm-orange)]">Field Notes</a>
						<a href="/topics/" class="hover:text-[var(--mm-orange)]">Topics</a>
						<a href="/resources/" class="hover:text-[var(--mm-orange)]">Resources</a>
					</div>
				</nav>
				<nav aria-label="Connect">
					<p class="font-mono text-xs font-bold uppercase tracking-[0.14em] text-[var(--mm-orange)]">Connect</p>
					<div class="mt-4 grid gap-3 text-sm font-semibold">
						<a href="/ai-unplugged/" class="hover:text-[var(--mm-orange)]">AI Unplugged</a>
						<a href="/podcast/" class="hover:text-[var(--mm-orange)]">Podcast</a>
						<a href="/about/" class="hover:text-[var(--mm-orange)]">About Mike</a>
						<a href="/media-kit/" class="hover:text-[var(--mm-orange)]">Media Kit</a>
						<a href="/contact/" class="hover:text-[var(--mm-orange)]">Contact</a>
					</div>
				</nav>
			</div>
			<div class="border-t border-[color-mix(in_srgb,var(--mm-cream)_18%,transparent)]">
				<div class="mm-container flex flex-wrap items-center justify-between gap-3 py-5 font-mono text-[0.68rem] uppercase tracking-[0.1em] text-[color-mix(in_srgb,var(--mm-cream)_62%,transparent)]">
					<p>© {new Date().getFullYear()} Mike Murphy</p>
					<nav aria-label="Legal" class="flex flex-wrap gap-x-5 gap-y-2">
						<a href="/privacy-policy/" class="hover:text-[var(--mm-orange)]">Privacy Policy</a>
						<a href="/terms-of-service/" class="hover:text-[var(--mm-orange)]">Terms of Service</a>
						<a href="/disclaimer/" class="hover:text-[var(--mm-orange)]">Disclaimer</a>
						<a href="/accessibility-statement/" class="hover:text-[var(--mm-orange)]">Accessibility</a>
					</nav>
					<p>Built with Astro · Served by Cloudflare</p>
				</div>
			</div>
		</footer>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}
</style>
